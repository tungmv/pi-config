# --- pi (pi-coding-agent) setup ---
# Put the user npm-global bin on PATH so `pi` is available
export PATH=~/.npm-global/bin:$PATH

# Model-server / provider env (secrets redacted — fill in your own)
export NOVITA_API_KEY="YOUR_NOVITA_API_KEY"

# Optional overrides for the fetch-models-x220 extension
# export MODELS_SERVER_URL="http://x220:8317"
# export MODELS_API_KEY="local"
